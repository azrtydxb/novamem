{
  "name": "@azrtydxb/novamem-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone tiered memory service for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docs:api": "pnpm --filter @azrtydxb/novamem-server build && pnpm --filter @azrtydxb/novamem-server docs:api"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.5": ">=7.5.5",
      "esbuild@<0.25.0": ">=0.25.0",
      "vite@<6.4.2": ">=6.4.2"
    }
  }
}
