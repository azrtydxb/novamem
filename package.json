{
  "name": "@azrtydxb/novamem-monorepo",
  "version": "1.1.2",
  "private": true,
  "description": "Standalone tiered memory service for AI agents",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "bench:smoke": "pnpm --filter @azrtydxb/novamem-benchmarks build && node packages/benchmarks/dist/cli.js --fixture packages/benchmarks/fixtures/novamem-recall-smoke.json",
    "docs:api": "pnpm --filter @azrtydxb/novamem-server build && pnpm --filter @azrtydxb/novamem-server docs:api",
    "docs:smoke": "node scripts/doc-smoke.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.19"
  },
  "pnpm": {
    "comment": "Overrides for transitive dependencies carrying HIGH/CRITICAL advisories that their direct parents have not yet released a fix for. Each entry is a floor, not a pin, so a parent that later bumps past it still wins. Re-check with `pnpm audit --prod --audit-level=high` and drop entries once the parent ships the fix.",
    "overrides": {
      "esbuild@<0.25.0": ">=0.25.0",
      "vite@<8.0.16": ">=8.0.16",
      "brace-expansion@<5.0.9": ">=5.0.9",
      "fast-uri@<3.1.5": ">=3.1.5",
      "find-my-way@<9.7.0": ">=9.7.0",
      "hono@<4.12.25": ">=4.12.25",
      "ip-address@<10.3.1": ">=10.3.1",
      "nanoid@<3.3.17": ">=3.3.17",
      "postcss@<8.5.18": ">=8.5.18",
      "protobufjs@<8.4.1": ">=8.4.1",
      "sharp@<0.35.0": ">=0.35.0",
      "undici@<6.27.0": ">=6.27.0",
      "ws@<8.21.0": ">=8.21.0",
      "@opentelemetry/propagator-jaeger@<2.9.0": ">=2.9.0"
    }
  }
}
