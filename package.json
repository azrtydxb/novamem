{
  "name": "@azrty/novamem-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone tiered memory service for AI agents",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "docs:api": "pnpm --filter @azrty/novamem-server build && pnpm --filter @azrty/novamem-server docs:api"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.5": ">=7.5.5"
    }
  }
}
