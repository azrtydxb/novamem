# novamem environment variables. Copy to `.env` and edit, or pass via your
# deployment system. See SECURITY.md for the production hardening checklist.

# ─── Service ─────────────────────────────────────────────────────────────
NOVAMEM_HOST=0.0.0.0
NOVAMEM_PORT=7778
NOVAMEM_RATE_LIMIT_PER_MINUTE=600
LOG_LEVEL=info

# Public URL the dashboard reaches the API on. Better Auth uses this for
# trusted-origin / CSRF checks — it MUST match the browser's Origin
# header exactly. Set explicitly in production.
NOVAMEM_BASE_URL=http://localhost:7778

# ─── Auth ────────────────────────────────────────────────────────────────
# user = per-user isolation; bearer = single shared token; none = dev-only
NOVAMEM_AUTH_MODE=user
# Required when AUTH_MODE=bearer
# NOVAMEM_AUTH_TOKEN=

# Cookie + JWT signing secret used by Better Auth. `openssl rand -hex 32`.
# The dev fallback string MUST NOT be used in production.
NOVAMEM_COOKIE_SECRET=

# Set to "1" to allow non-Secure cookies (plain-HTTP dev / k3s LB without
# TLS). Unset / "0" in production so cookies require HTTPS.
NOVAMEM_INSECURE_COOKIES=0

# ─── Bootstrap admin (only consulted when no admin user exists) ──────────
# Auto-scrubbed from process.env after seeding so it doesn't surface
# via `docker inspect`. Min password length 8 (Better Auth default).
NOVAMEM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NOVAMEM_BOOTSTRAP_ADMIN_PASSWORD=

# ─── Dashboard ───────────────────────────────────────────────────────────
NOVAMEM_ADMIN_DASHBOARD=1
# Comma-separated list, "*" for permissive, "" or "self" for same-origin only.
NOVAMEM_CORS_ORIGINS=

# ─── Storage ─────────────────────────────────────────────────────────────
NOVAMEM_WARM_URL=postgres://novamem:novamem@localhost:5432/novamem
NOVAMEM_COLD_URL=http://localhost:6333
NOVAMEM_COLD_VECTOR_SIZE=384
NOVAMEM_GRAPH_ENABLED=true
NOVAMEM_GRAPH_URL=redis://localhost:6379

# Postgres connection pool size (per process).
NOVAMEM_PG_POOL_MAX=20

# ─── Embeddings ──────────────────────────────────────────────────────────
# `local-transformers` ships @xenova/transformers; no external API key needed.
NOVAMEM_EMBEDDINGS_PROVIDER=local-transformers
# For OpenAI-compatible endpoints:
# NOVAMEM_EMBEDDINGS_PROVIDER=openai-compatible
# NOVAMEM_EMBEDDINGS_ENDPOINT=https://api.openai.com/v1
# NOVAMEM_EMBEDDINGS_MODEL=text-embedding-3-small
# NOVAMEM_EMBEDDINGS_API_KEY=
NOVAMEM_EMBEDDINGS_DIM=384

# ─── Decay loop ──────────────────────────────────────────────────────────
# Interval applies to both decay and the dream cycle (compaction +
# edge promotion). 6h default.
NOVAMEM_DECAY_INTERVAL_MS=21600000
NOVAMEM_DECAY_DAYS=7
