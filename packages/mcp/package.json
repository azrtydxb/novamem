{
  "name": "@azrtydxb/novamem-mcp",
  "version": "1.2.1",
  "description": "MCP-stdio shim for the novamem memory service — bridges stdio↔HTTP for legacy clients",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "novamem-mcp": "dist/bin.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
