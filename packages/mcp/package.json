  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrtydxb/novamem.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/azrtydxb/novamem#readme",
  "bugs": {
    "url": "https://github.com/azrtydxb/novamem/issues"
  },
  "devDependencies": {
    "@types/node": "^24",
    "vitest": "^4.1.7"
  }
}
