{
  "name": "@azrtydxb/novamem-init",
  "version": "1.2.1",
  "private": false,
  "description": "Interactive installer that signs in to a novamem server, mints a bearer, and wires every supported AI agent host (Claude Code, Cursor, Codex, OpenCode, Cline, Continue, Kilo Code, RooCode, Claude Desktop, …) to use it",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "novamem-init": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-assets.mjs",
    "pretest": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/main.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "commander": "^14.0.0",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "@types/node": "^22.10.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrtydxb/novamem.git",
    "directory": "packages/init"
  },
  "homepage": "https://github.com/azrtydxb/novamem#readme",
  "bugs": {
    "url": "https://github.com/azrtydxb/novamem/issues"
  }
}
