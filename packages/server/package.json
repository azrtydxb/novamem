    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "pg": "^8.13.1",
    "better-sqlite3": "^11.5.0",
    "ulid": "^2.3.0",
    "zod": "^3.23.8",
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/pg": "^8.11.10",
