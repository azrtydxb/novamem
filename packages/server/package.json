{
  "name": "@azrtydxb/novamem-server",
  "version": "1.1.7",
  "private": true,
  "description": "Standalone tiered memory service — HTTP + MCP transports",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine/index.js"
  },
  "bin": {
    "novamem-server": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && pnpm run build:assets && node scripts/check-runtime-deps.mjs",
    "build:assets": "node ./scripts/copy-admin-ui.mjs",
    "test": "vitest run",
    "test:integration": "NOVAMEM_INTEGRATION=1 vitest run --dir tests",
    "docs:api": "node ./scripts/gen-openapi.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:introspect": "drizzle-kit introspect",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts",
    "check:runtime-deps": "node scripts/check-runtime-deps.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/otel": "^0.20.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "falkordb": "^6.7.0",
    "fastify": "^5.11.3",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.22.0",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@azrtydxb/novamem-admin-ui": "workspace:*",
    "@types/node": "^24",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.11",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azrtydxb/novamem.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/azrtydxb/novamem#readme",
  "bugs": {
    "url": "https://github.com/azrtydxb/novamem/issues"
  }
}
