{
  "name": "@azrty/novamem-server",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone tiered memory service — HTTP + MCP transports",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine/index.js"
  },
  "bin": {
    "novamem-server": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && pnpm run build:assets",
    "build:assets": "node ./scripts/copy-admin-ui.mjs",
    "test": "vitest run",
    "test:integration": "NOVAMEM_INTEGRATION=1 vitest run --dir tests",
    "docs:api": "node ./scripts/gen-openapi.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/main.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@qdrant/js-client-rest": "^1.12.0",
    "@xenova/transformers": "^2.17.2",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "falkordb": "^6.2.7",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "ulid": "^3.0.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@azrty/novamem-admin-ui": "workspace:*",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
